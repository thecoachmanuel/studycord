# ==========================================
# Elite Quiz System Configuration & Secrets
# ==========================================

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/elite_quiz_db

# Admin Credentials (Editable by administrator)
# Keep this secret - Admin portal is NOT exposed in public user navigation
ADMIN_EMAIL=admin@studycord.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_JWT_SECRET=your_random_secret_jwt_key_here

# System & App Configurations
NEXT_PUBLIC_APP_NAME="StudyCord"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="2.3.7"
